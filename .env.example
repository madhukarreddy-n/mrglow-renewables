# PostgreSQL — required at runtime (Docker locally; Supabase / Neon / RDS on Vercel)
# Vercel: set this on the project (Production + Preview). Use ?sslmode=require for hosted Postgres.
DATABASE_URL="postgresql://mrglow:mrglow@localhost:5432/mrglow?schema=public"

# Auth
AUTH_SECRET="generate-a-long-random-string"
AUTH_COOKIE_NAME="mrglow_session"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Email (provider-independent; SES compatible SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mr.GLOW RENEWABLES <mrglowrenewables@gmail.com>"
LEAD_NOTIFY_EMAIL="mrglowrenewables@gmail.com"

# Object storage (S3-compatible; local fallback if unset)
STORAGE_DRIVER="local"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional spam protection
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Seed admin (development only — change before production)
SEED_ADMIN_EMAIL="admin@mrglowrenewables.in"
SEED_ADMIN_PASSWORD="ChangeMeNow!2026"
